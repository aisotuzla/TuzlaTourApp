{
  "version": 8,
  "name": "Tuzla Offline Dark",
  "metadata": {
    "maputnik:renderer": "mlgljs"
  },
  "sources": {
    "protomaps": {
      "type": "vector",
      "url": "pmtiles:///maps/tuzla.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    },
    "app-buildings": {
      "type": "geojson",
      "data": "/MAP/buildings.geojson"
    },
    "tour-data": {
      "type": "geojson",
      "data": "/maps/TuzlaTourGuide.geojson"
    },
    "app-pois": {
      "type": "geojson",
      "data": "/poi.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0f172a"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#1e293b"
      }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["in", "kind", "park", "forest", "grass", "garden", "nature_reserve", "wood", "cemetery"],
      "paint": {
        "fill-color": "#1a2e1a",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["in", "kind", "residential", "neighbourhood"],
      "paint": {
        "fill-color": "#1a2332",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "landuse-commercial",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["in", "kind", "commercial", "industrial", "retail"],
      "paint": {
        "fill-color": "#1e2235",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "paint": {
        "fill-color": "#1e3a5f"
      }
    },
    {
      "id": "water-line",
      "type": "line",
      "source": "protomaps",
      "source-layer": "water",
      "filter": ["==", "$type", "LineString"],
      "paint": {
        "line-color": "#2563eb",
        "line-width": 1,
        "line-opacity": 0.5
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "protomaps",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#475569",
        "line-width": 1,
        "line-dasharray": [3, 2],
        "line-opacity": 0.5
      }
    },
    {
      "id": "roads-path",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["in", "kind", "path", "footway", "cycleway", "pedestrian", "steps"],
      "minzoom": 14,
      "paint": {
        "line-color": "#334155",
        "line-width": 0.8,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["in", "kind", "residential", "service", "unclassified", "living_street", "track"],
      "minzoom": 12,
      "paint": {
        "line-color": "#334155",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 15, 2]
      }
    },
    {
      "id": "roads-tertiary",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["in", "kind", "tertiary", "tertiary_link"],
      "minzoom": 10,
      "paint": {
        "line-color": "#475569",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 15, 3]
      }
    },
    {
      "id": "roads-secondary",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["in", "kind", "secondary", "secondary_link"],
      "minzoom": 8,
      "paint": {
        "line-color": "#64748b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 15, 4]
      }
    },
    {
      "id": "roads-primary",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["in", "kind", "primary", "primary_link"],
      "minzoom": 6,
      "paint": {
        "line-color": "#94a3b8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 15, 5]
      }
    },
    {
      "id": "roads-highway",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["in", "kind", "motorway", "motorway_link", "trunk", "trunk_link"],
      "paint": {
        "line-color": "#f59e0b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.5, 15, 6],
        "line-opacity": 0.8
      }
    },
    {
      "id": "bridges",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["==", "is_bridge", true],
      "minzoom": 12,
      "paint": {
        "line-color": "#64748b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 15, 4]
      }
    },
    {
      "id": "buildings",
      "type": "fill-extrusion",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-extrusion-color": "#334155",
        "fill-extrusion-height": ["coalesce", ["get", "height"], 10],
        "fill-extrusion-base": ["coalesce", ["get", "min_height"], 0],
        "fill-extrusion-opacity": 0.5
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 14,
      "filter": ["has", "name"],
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-size": 11,
        "text-font": ["Noto Sans Regular"],
        "text-max-angle": 30,
        "symbol-spacing": 300
      },
      "paint": {
        "text-color": "#94a3b8",
        "text-halo-color": "#0f172a",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "places-city",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "filter": ["in", "kind", "city", "town"],
      "layout": {
        "text-field": "{name}",
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 12, 14, 22],
        "text-font": ["Noto Sans Bold"],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#e2e8f0",
        "text-halo-color": "#0f172a",
        "text-halo-width": 2
      }
    },
    {
      "id": "places-other",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "minzoom": 12,
      "filter": ["in", "kind", "village", "suburb", "neighbourhood", "hamlet", "locality"],
      "layout": {
        "text-field": "{name}",
        "text-size": 12,
        "text-font": ["Noto Sans Regular"]
      },
      "paint": {
        "text-color": "#94a3b8",
        "text-halo-color": "#0f172a",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "pois",
      "minzoom": 14,
      "filter": ["has", "name"],
      "layout": {
        "text-field": "{name}",
        "text-size": 10,
        "text-font": ["Noto Sans Regular"],
        "text-offset": [0, 1.5],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#64748b",
        "text-halo-color": "#0f172a",
        "text-halo-width": 1
      }
    },
    {
      "id": "app-buildings-3d",
      "type": "fill-extrusion",
      "source": "app-buildings",
      "minzoom": 13,
      "paint": {
        "fill-extrusion-color": "#cbd5e1",
        "fill-extrusion-height": ["coalesce", ["get", "height"], 15],
        "fill-extrusion-base": ["coalesce", ["get", "min_height"], 0],
        "fill-extrusion-opacity": 0.5
      }
    },
    {
      "id": "tour-route-line",
      "type": "line",
      "source": "tour-data",
      "filter": ["==", "$type", "LineString"],
      "paint": {
        "line-color": "#3b82f6",
        "line-width": 3,
        "line-opacity": 0.7,
        "line-dasharray": [2, 1]
      }
    },
    {
      "id": "tour-points",
      "type": "circle",
      "source": "tour-data",
      "filter": ["==", "$type", "Point"],
      "paint": {
        "circle-radius": 5,
        "circle-color": "#8b5cf6",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      }
    },
    {
      "id": "poi-icons",
      "type": "circle",
      "source": "app-pois",
      "paint": {
        "circle-radius": 8,
        "circle-color": "#3b82f6",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      }
    }
  ]
}