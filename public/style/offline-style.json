{
  "version": 8,
  "name": "Tuzla Offline Dark",
  "metadata": {
    "maputnik:renderer": "mlgljs"
  },
  "sources": {
    "local-raster": {
      "type": "raster",
      "tiles": [
        "/maps/tiles/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "minzoom": 14,
      "maxzoom": 16,
      "bounds": [
        18.55,
        44.50,
        18.75,
        44.58
      ]
    },
    "app-buildings": {
      "type": "geojson",
      "data": "/maps/buildings.geojson"
    },
    "tour-data": {
      "type": "geojson",
      "data": "/maps/TuzlaTourGuide.geojson"
    },
    "app-pois": {
      "type": "geojson",
      "data": "/poi.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0f172a"
      }
    },
    {
      "id": "raster-tiles",
      "type": "raster",
      "source": "local-raster",
      "paint": {
        "raster-opacity": 1,
        "raster-saturation": -0.3,
        "raster-brightness-max": 0.7,
        "raster-contrast": 0.1
      }
    },
    {
      "id": "app-buildings-3d",
      "type": "fill-extrusion",
      "source": "app-buildings",
      "minzoom": 13,
      "paint": {
        "fill-extrusion-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "coalesce",
            [
              "get",
              "height"
            ],
            15
          ],
          0,
          "#ffffff",
          20,
          "#677891",
          50,
          "#E5E4E2",
          100,
          "#E5E4E2"
        ],
        "fill-extrusion-height": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0,
          14,
          [
            "*",
            [
              "coalesce",
              [
                "get",
                "height"
              ],
              15
            ],
            3.5
          ]
        ],
        "fill-extrusion-base": [
          "coalesce",
          [
            "get",
            "min_height"
          ],
          0
        ],
        "fill-extrusion-opacity": 0.75
      }
    },
    {
      "id": "tour-route-line",
      "type": "line",
      "source": "tour-data",
      "filter": [
        "==",
        "$type",
        "LineString"
      ],
      "paint": {
        "line-color": "#3b82f6",
        "line-width": 3,
        "line-opacity": 0.7,
        "line-dasharray": [
          2,
          1
        ]
      }
    },
    {
      "id": "tour-points",
      "type": "circle",
      "source": "tour-data",
      "filter": [
        "==",
        "$type",
        "Point"
      ],
      "paint": {
        "circle-radius": 5,
        "circle-color": "#8b5cf6",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      }
    },
    {
      "id": "poi-icons",
      "type": "circle",
      "source": "app-pois",
      "paint": {
        "circle-radius": 8,
        "circle-color": "#3b82f6",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      }
    }
  ]
}