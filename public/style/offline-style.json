{
  "version": 8,
  "name": "Tuzla Offline Dark",
  "metadata": {
    "maputnik:renderer": "mlgljs"
  },
  "sources": {
    "local-raster": {
      "type": "raster",
      "tiles": [
        "https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png",
        "https://b.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png",
        "https://c.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png",
        "https://d.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png"
      ],
      "tileSize": 256,
      "minzoom": 0,
      "maxzoom": 19
    },
    "app-buildings": {
      "type": "geojson",
      "data": "/maps/buildings.geojson"
    },
    "tour-data": {
      "type": "geojson",
      "data": "/maps/TuzlaTourGuide.geojson"
    },
    "app-pois": {
      "type": "geojson",
      "data": "/poi.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#eaeef7"
      }
    },
    {
      "id": "raster-tiles",
      "type": "raster",
      "source": "local-raster",
      "paint": {
        "raster-opacity": 1
      }
    },
    {
      "id": "app-buildings-3d",
      "type": "fill-extrusion",
      "source": "app-buildings",
      "minzoom": 13,
      "paint": {
        "fill-extrusion-color": "#eaeef7",
        "fill-extrusion-height": [
          "get",
          "height"
        ],
        "fill-extrusion-base": [
          "coalesce",
          [
            "get",
            "min_height"
          ],
          0
        ],
        "fill-extrusion-opacity": 0.95,
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "tour-route-line",
      "type": "line",
      "source": "tour-data",
      "filter": [
        "==",
        "$type",
        "LineString"
      ],
      "paint": {
        "line-color": "#3b82f6",
        "line-width": 3,
        "line-opacity": 0.7,
        "line-dasharray": [
          2,
          1
        ]
      }
    },
    {
      "id": "tour-points",
      "type": "circle",
      "source": "tour-data",
      "filter": [
        "==",
        "$type",
        "Point"
      ],
      "paint": {
        "circle-radius": 5,
        "circle-color": "#8b5cf6",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      }
    },
    {
      "id": "poi-icons",
      "type": "circle",
      "source": "app-pois",
      "paint": {
        "circle-radius": 8,
        "circle-color": "#3b82f6",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      }
    }
  ]
}