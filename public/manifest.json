{
  "manifest_version": 3,
  "version": "1",
  "name": "Tuzla Tour Guide App",
  "short_name": "Tuzla Guide",
  "description": "Multilingual tour guide for Tuzla with GPS, AR quests, audio guides, itinerary, and all local info to explore the city of Tuzla.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#1e3a8a",
  "categories": [
    "travel",
    "navigation",
    "entertainment",
    "lifestyle",
    "education"
  ],
  "lang": "en",
  "dir": "ltr",
  "icons": {
    "96": "/resources/TuzlaTourAppLogo96x96.png",
    "192": "/resources/TuzlaTourAppLogo192x192.png",
    "512": "/resources/TuzlaTourAppLogo512x512.png"
  },
  "shortcuts": [
    {
      "name": "QR Quest & Scavenger Hunt",
      "short_name": "QR Quest",
      "description": "Explore Tuzla landmarks with QR codes, scan and earn rewards",
      "url": "/?tab=quest",
      "icons": [
        {
          "src": "/resources/TuzlaTourAppLogo96x96.png",
          "sizes": "96x96",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "3D GPS Map & Navigation",
      "short_name": "GPS Map",
      "description": "Navigate Tuzla with live 3D vector maps, routing, and offline support",
      "url": "/?tab=map",
      "icons": [
        {
          "src": "/resources/TuzlaTourAppLogo96x96.png",
          "sizes": "96x96",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Transportation",
      "short_name": "Transportation",
      "description": "Information about transportation in Tuzla, bus, taxi, car rental",
      "url": "/?tab=transportation",
      "icons": [
        {
          "src": "/resources/TuzlaTourAppLogo96x96.png",
          "sizes": "96x96",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Personal Itinerary & Expenses",
      "short_name": "Itinerary",
      "description": "Organize your stay, check off visited places, and track travel expenses",
      "url": "/?tab=task-manager",
      "icons": [
        {
          "src": "/resources/TuzlaTourAppLogo96x96.png",
          "sizes": "96x96",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ]
}