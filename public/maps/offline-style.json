{
  "version": 8,
  "name": "Tuzla Offline Style",
  "metadata": {
    "maputnik:renderer": "mlgljs"
  },
  "sources": {
    "local-raster": {
      "type": "raster",
      "tiles": [
        "/maps/tiles/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "minzoom": 1,
      "maxzoom": 18
    },
    "app-buildings": {
      "type": "geojson",
      "data": "/TuzlaTourGuide.geojson"
    },
    "tour-data": {
      "type": "geojson",
      "data": "/maps/tour-data.geojson"
    },
    "app-pois": {
      "type": "geojson",
      "data": "/poi.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0f172a"
      }
    },
    {
      "id": "raster-tiles",
      "type": "raster",
      "source": "local-raster",
      "paint": {
        "raster-opacity": 1
      }
    },
    {
      "id": "app-buildings-3d",
      "type": "fill-extrusion",
      "source": "app-buildings",
      "minzoom": 13,
      "paint": {
        "fill-extrusion-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "coalesce",
            [
              "get",
              "height"
            ],
            15
          ],
          0,
          "#f8fafc",
          15,
          "#e2e8f0",
          30,
          "#cbd5e1",
          60,
          "#94a3b8",
          100,
          "#64748b"
        ],
        "fill-extrusion-height": [
          "coalesce",
          [
            "get",
            "height"
          ],
          15
        ],
        "fill-extrusion-base": [
          "coalesce",
          [
            "get",
            "min_height"
          ],
          0
        ],
        "fill-extrusion-opacity": 0.85,
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "tour-route-line",
      "type": "line",
      "source": "tour-data",
      "filter": [
        "==",
        "$type",
        "LineString"
      ],
      "paint": {
        "line-color": "#3b82f6",
        "line-width": 3,
        "line-opacity": 0.7,
        "line-dasharray": [
          2,
          1
        ]
      }
    },
    {
      "id": "tour-points",
      "type": "circle",
      "source": "tour-data",
      "filter": [
        "==",
        "$type",
        "Point"
      ],
      "paint": {
        "circle-radius": 5,
        "circle-color": "#8b5cf6",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      }
    },
    {
      "id": "poi-icons",
      "type": "circle",
      "source": "app-pois",
      "paint": {
        "circle-radius": 8,
        "circle-color": "#3b82f6",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      }
    }
  ]
}